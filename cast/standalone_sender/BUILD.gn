import("//build_overrides/build.gni")
import("../../gni/openscreen.gni")
import("../streaming/external_libraries.gni")

visibility = [ "./*" ]

# Define the executable target only when the build is configured to use the
# standalone platform implementation; since this is itself a standalone
# application.
if (!build_with_chromium) {
  have_external_libs = have_ffmpeg && have_libopus && have_libvpx

  config("standalone_external_libs") {
    defines = []
    if (have_external_libs) {
      defines += [ "CAST_STANDALONE_SENDER_HAVE_EXTERNAL_LIBS" ]
    }
    if (have_libaom) {
      defines += [ "CAST_STANDALONE_SENDER_HAVE_LIBAOM" ]
    }
    if (is_android) {
      defines += [ "CAST_STANDALONE_SENDER_HAVE_MEDIACODEC" ]
    }
  }

  if (have_external_libs) {
    openscreen_source_set("controllable_sender_core") {
      testonly = true
      visibility += [ "../..:gn_all" ]
      deps = [
        "../../platform",
        "../../platform:standalone_impl",
        "../../third_party/jsoncpp",
        "../../util",
        "../common:certificate_boringssl",
        "../common:public",
        "../common/channel/proto:channel_proto",
        "../sender:channel",
        "../streaming:common",
        "../streaming:sender",
      ]

      sources = [
        "connection_settings.h",
        "controllable_file_cast_agent.cc",
        "controllable_file_cast_agent.h",
        "controllable_file_sender.cc",
        "controllable_file_sender.h",
        "ffmpeg_glue.cc",
        "ffmpeg_glue.h",
        "streaming_encoder_util.cc",
        "streaming_encoder_util.h",
        "streaming_opus_encoder.cc",
        "streaming_opus_encoder.h",
        "streaming_video_encoder.cc",
        "streaming_video_encoder.h",
        "streaming_vpx_encoder.cc",
        "streaming_vpx_encoder.h",
        "simulated_capturer.cc",
        "simulated_capturer.h",
      ]

      include_dirs =
          ffmpeg_include_dirs + libopus_include_dirs + libvpx_include_dirs
      lib_dirs = external_lib_dirs + ffmpeg_lib_dirs + libopus_lib_dirs +
                 libvpx_lib_dirs
      libs = ffmpeg_libs + libopus_libs + libvpx_libs

      if (have_libaom) {
        sources += [
          "streaming_av1_encoder.cc",
          "streaming_av1_encoder.h",
        ]
        include_dirs += libaom_include_dirs
        lib_dirs += libaom_lib_dirs
        libs += libaom_libs
      }

      if (is_android) {
        sources += [
          "streaming_mediacodec_encoder.cc",
          "streaming_mediacodec_encoder.h",
        ]
        libs += [
          "EGL",
          "GLESv2",
          "android",
          "mediandk",
        ]
      }

      configs = [ "../common:certificate_config" ]
      public_configs = [ ":standalone_external_libs" ]
    }
  }

  openscreen_executable("cast_sender") {
    testonly = true
    visibility += [ "../..:gn_all" ]
    deps = [
      "../../discovery:dnssd",
      "../../discovery:public",
      "../../platform",
      "../../platform:standalone_impl",
      "../../third_party/getopt",
      "../../third_party/jsoncpp",
      "../../util",
      "../common:certificate_boringssl",
      "../common:public",
      "../common/channel/proto:channel_proto",
      "../sender:channel",
      "../streaming:common",
      "../streaming:sender",
    ]

    sources = [ "main.cc" ]
    include_dirs = []
    lib_dirs = []
    libs = []
    if (have_external_libs) {
      sources += [
        "connection_settings.h",
        "ffmpeg_glue.cc",
        "ffmpeg_glue.h",
        "looping_file_cast_agent.cc",
        "looping_file_cast_agent.h",
        "looping_file_sender.cc",
        "looping_file_sender.h",
        "receiver_chooser.cc",
        "receiver_chooser.h",
        "remoting_sender.cc",
        "remoting_sender.h",
        "simulated_capturer.cc",
        "simulated_capturer.h",
        "streaming_encoder_util.cc",
        "streaming_encoder_util.h",
        "streaming_opus_encoder.cc",
        "streaming_opus_encoder.h",
        "streaming_video_encoder.cc",
        "streaming_video_encoder.h",
        "streaming_vpx_encoder.cc",
        "streaming_vpx_encoder.h",
      ]

      include_dirs +=
          ffmpeg_include_dirs + libopus_include_dirs + libvpx_include_dirs
      lib_dirs += external_lib_dirs + ffmpeg_lib_dirs + libopus_lib_dirs +
                  libvpx_lib_dirs
      libs += ffmpeg_libs + libopus_libs + libvpx_libs

      # LibAOM support currently recommends building from source, so is included
      # separately here.
      if (have_libaom) {
        sources += [
          "streaming_av1_encoder.cc",
          "streaming_av1_encoder.h",
        ]

        include_dirs += libaom_include_dirs
        lib_dirs += libaom_lib_dirs
        libs += libaom_libs
      }
    }

    configs = [ "../common:certificate_config" ]

    public_configs = [ ":standalone_external_libs" ]
  }

  # x11cast: Cast X11 desktop to Chromecast using native Cast protocol.
  if (have_external_libs) {
    openscreen_executable("x11cast") {
      testonly = true
      visibility += [ "../..:gn_all" ]
      deps = [
        "../../discovery:dnssd",
        "../../discovery:public",
        "../../platform",
        "../../platform:standalone_impl",
        "../../third_party/jsoncpp",
        "../../util",
        "../common:certificate_boringssl",
        "../common:public",
        "../common/channel/proto:channel_proto",
        "../sender:channel",
        "../streaming:common",
        "../streaming:sender",
      ]

      sources = [
        "x11cast_main.cc",
        "connection_settings.h",
        "receiver_chooser.cc",
        "receiver_chooser.h",
        "x11_cast_agent.cc",
        "x11_cast_agent.h",
        "x11_sender.cc",
        "x11_sender.h",
        "x11_capturer.cc",
        "x11_capturer.h",
        "pulse_capturer.cc",
        "pulse_capturer.h",
        "streaming_encoder_util.cc",
        "streaming_encoder_util.h",
        "streaming_opus_encoder.cc",
        "streaming_opus_encoder.h",
        "streaming_video_encoder.cc",
        "streaming_video_encoder.h",
        "streaming_vpx_encoder.cc",
        "streaming_vpx_encoder.h",
      ]

      include_dirs =
          ffmpeg_include_dirs + libopus_include_dirs + libvpx_include_dirs
      lib_dirs = external_lib_dirs + ffmpeg_lib_dirs + libopus_lib_dirs +
                 libvpx_lib_dirs
      libs = ffmpeg_libs + libopus_libs + libvpx_libs + [
        "X11",
        "Xext",
        "Xcomposite",
        "Xdamage",
        "Xfixes",
        "pulse-simple",
        "pulse",
      ]

      if (have_libaom) {
        sources += [
          "streaming_av1_encoder.cc",
          "streaming_av1_encoder.h",
        ]
        include_dirs += libaom_include_dirs
        lib_dirs += libaom_lib_dirs
        libs += libaom_libs
      }

      configs = [ "../common:certificate_config" ]
      public_configs = [ ":standalone_external_libs" ]
      data_deps = [
        ":x11cast_py",
        ":x11castapp_py",
      ]
    }

    copy("x11cast_py") {
      testonly = true
      visibility += [
        "../..:gn_all",
        ":x11cast",
      ]
      sources = [ "x11cast.py" ]
      outputs = [ "$root_out_dir/x11cast.py" ]
    }

    copy("x11castapp_py") {
      testonly = true
      visibility += [
        "../..:gn_all",
        ":x11cast",
      ]
      sources = [ "x11castapp.py" ]
      outputs = [ "$root_out_dir/x11castapp.py" ]
    }

    # Android JNI shared library for the ControlCast app.
    # Build with: gn gen out/android --args='target_os="android" ...'
    #             ninja -C out/android controlcast
    # Then copy libcontrolcast.so into the APK's jniLibs directory.
    openscreen_shared_library("controlcast") {
      testonly = true
      visibility += [ "../..:gn_all" ]
      deps = [
        ":controllable_sender_core",
        "../../platform",
        "../../platform:standalone_impl",
        "../../third_party/jsoncpp",
        "../../util",
        "../common:certificate_boringssl",
        "../common:public",
        "../common/channel/proto:channel_proto",
        "../sender:channel",
        "../streaming:common",
        "../streaming:sender",
      ]
      sources = [ "controlcast_jni.cpp" ]
      defines = [ "HAVE_OPENSCREEN" ]
      include_dirs =
          ffmpeg_include_dirs + libopus_include_dirs + libvpx_include_dirs
      lib_dirs = external_lib_dirs + ffmpeg_lib_dirs + libopus_lib_dirs +
                 libvpx_lib_dirs
      libs = ffmpeg_libs + libopus_libs + libvpx_libs + [
        "z",
        "log",
      ]
      ldflags = [
        "-Wl,--version-script=" +
            rebase_path("//build/android/android_only_jni_exports.lst",
                        root_build_dir),
      ]
      configs = [ "../common:certificate_config" ]
      public_configs = [ ":standalone_external_libs" ]
    }
  }
}
